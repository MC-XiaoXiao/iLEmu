string(TIMESTAMP ILEMU_BUILD_TIMESTAMP "%Y-%m-%dT%H:%M:%SZ" UTC)
foreach(field ILEMU_BUILD_VERSION ILEMU_BUILD_USER)
    string(REPLACE "\\" "\\\\" ${field} "${${field}}")
    string(REPLACE "\"" "\\\"" ${field} "${${field}}")
    string(REPLACE "\n" "\\n" ${field} "${${field}}")
    string(REPLACE "\r" "\\r" ${field} "${${field}}")
endforeach()
file(CONFIGURE OUTPUT "${ILEMU_BUILD_INFO_SOURCE}" CONTENT [=[
// Generated by CMake; shared by the application and compatibility kernel.
#include "foundation/build_info.hpp"

namespace ilemu {

const BuildInfo& BuildInfo::current()
{
    static constexpr BuildInfo info {
        "@ILEMU_BUILD_VERSION@", "@ILEMU_BUILD_TIMESTAMP@", "@ILEMU_BUILD_USER@"
    };
    return info;
}

} // namespace ilemu
]=] @ONLY)
