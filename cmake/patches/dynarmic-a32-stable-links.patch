+void A32EmitX64::EmitStableLink(
+        const IR::LocationDescriptor& target_desc) {
+    using namespace Xbyak::util;
+
+    Xbyak::Label miss, no_rsb;
+    const auto target = target_desc.Value();
+    code.mov(rbx, target);
+    code.mov(r12, qword[r15 + offsetof(A32JitState, fast_dispatch_table_link)]);
+    code.mov(r12, qword[r12]);
+    code.lea(rbp, ptr[r12 + fast_dispatch_table_index(target)]);
+    code.cmp(rbx, qword[rbp + offsetof(FastDispatchEntry, location_descriptor)]);
+    code.jne(miss);
+    code.mov(rax, qword[rbp + offsetof(FastDispatchEntry, code_ptr)]);
+    code.test(rax, rax);
+    code.jz(miss);
+
+    // PushRSB records the descriptor before this terminal runs. Once the
+    // stable slot is validated, publish its generation-local target into the
+    // matching executor-local RSB entry so returns can jump directly next
+    // time. A generation transition resets both structures before reuse.
+    code.mov(ecx, dword[r15 + offsetof(A32JitState, rsb_ptr)]);
+    code.sub(ecx, 1);
+    code.and_(ecx, u32(A32JitState::RSBPtrMask));
+    code.cmp(rbx, qword[r15 + offsetof(A32JitState, rsb_location_descriptors) +
+                         rcx * sizeof(u64)]);
+    code.jne(no_rsb);
+    code.mov(qword[r15 + offsetof(A32JitState, rsb_codeptrs) +
+                     rcx * sizeof(u64)], rax);
+    code.L(no_rsb);
+    code.jmp(rax);
+
+    code.L(miss);
+    code.jmp(terminal_handler_fast_dispatch_hint);
+}
