<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="模拟器容器" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="独立固件与数据 · Vulkan · 已激活" android:layout_marginTop="8dp" />
    <Button android:id="@+id/add_container" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="添加容器" android:layout_marginTop="12dp" />
    <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textIsSelectable="true" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/containers" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <Button android:id="@+id/diagnostics" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="诊断与运行日志" />
</LinearLayout>
